# Heltec WiFi LoRa 32 V4 board-specific sdkconfig overrides.
#
# USB-C is wired directly to the ESP32-S3 native USB pins (GPIO19 D-,
# GPIO20 D+). We drive the chip's USB-Serial-JTAG peripheral via
# UsbSerialDriver for the binary frame protocol.
#
# IMPORTANT: Console must NOT be routed to USB-Serial-JTAG. The VFS console
# driver and UsbSerialDriver both write to the same hardware TX FIFO and
# their bytes interleave, corrupting frame data.
#
# Relying on the ESP-IDF default was not enough, and this comment used to say
# it was. The PRIMARY console does default to UART0 (GPIO43/44), which is not
# connected to USB-C on the V4, so those bytes do go nowhere. But IDF also
# enables a SECONDARY console on S3, and that one is USB-Serial-JTAG:
#
#   CONFIG_ESP_CONSOLE_UART_DEFAULT=y
#   CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y   <-- interleaves
#
# Caught on the bench 2026-09-06: a malformed frame drew a coloured, timestamped
# `W (67716) heartwood_esp32::protocol: try_read_frame ...` back down the same
# port the frame protocol uses. The noisiest moment is a protocol error, which
# is exactly when a client is retrying.
#
# So silence the console entirely, as heltec-v3, tdisplay and c6 already do,
# and for the reason the V3 file states plainly: log lines interleaved with
# binary frames force every reader to hunt for magic bytes and corrupt OTA
# transfers outright. The firmware still calls log::info!/warn!/error!; the
# backend drops the output. Bring logs back on a dev build by flipping this to
# CONFIG_ESP_CONSOLE_UART_DEFAULT=y and wiring a UART probe to unused GPIOs --
# never to USB-Serial-JTAG, which is the frame channel.
CONFIG_ESP_CONSOLE_NONE=y
# BOTH are needed, and this is the trap: CONFIG_ESP_CONSOLE_NONE only silences
# the PRIMARY console. Verified against the generated sdkconfig -- with NONE
# alone, CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG stays =y and the log
# bytes still reach GPIO19/20, which on this board is the USB-C port carrying
# the frame protocol. heltec-v3 and the others get away with NONE by itself
# only because their native USB pins are not wired to anything.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
#
# Flash -- Heltec V4 typically ships with 16MB external flash (ESP32-S3R2),
# but 8MB is a safe floor and matches the partition table. Leaving the flash
# size at 8MB means a V4 with a 16MB variant simply under-uses the remaining
# space.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Run the CPU at the 240 MHz this chip supports, not the 160 MHz default.
#
# Straight 1.5x on everything compute-bound, for one line and no code change.
# The unseal is the case that made this visible -- ~29 s per sealed slot, and
# a cycle count says it should be a fraction of that (#121) -- but the same
# applies to every KDF on the device, including the note-key derivations and
# the at-rest rewrap.
#
# The cost is power draw, which matters for a battery-run signer and not at
# all for a USB-powered one. Revisit if this firmware ever ships on a board
# expected to run from its battery connector for long stretches.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Compile ESP-IDF's own C log calls out (Wi-Fi, TLS, NVS, the drivers). With
# both consoles off above, every one of those lines is formatted and then
# dropped, and the Rust side is already built with log/release_max_level_off,
# so this only removes the format strings and call sites: about 59 KB of the
# app image, and nothing a V4 user could see changes. A dev build that brings
# a console back must lift this too (CONFIG_LOG_DEFAULT_LEVEL_INFO=y), or it
# will stay silent. The colour-panel boards keep their C logs at the default.
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
